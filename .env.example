# Copy to .env and fill real values. .env is gitignored.

# --- Database ---
DATABASE_URL=postgresql+psycopg2://diagnoz:diagnoz@db:5432/diagnoz

# --- Redis (pub/sub, signaling relay, distributed locks, Celery broker) ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Auth ---
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Voice AI pipeline ---
WHISPER_MODEL=base
LLM_API_KEY=
LLM_MODEL=
TTS_API_KEY=
TTS_VOICE=

# --- Object storage (MinIO / S3) ---
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=diagnoz-media

# --- Media ---
REFERENCE_VIDEO_PATH=/var/storage/diagnoz/reference_videos
HLS_OUTPUT_PATH=/var/storage/diagnoz/hls

# --- Dispatch economics ---
PLATFORM_COMMISSION_RATE=0.15
TDS_RATE=0.01
DISPATCH_RADIUS_METERS=5000
DISPATCH_LOCK_TTL_SECONDS=300
